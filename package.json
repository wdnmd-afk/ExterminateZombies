{
  "name": "exterminate-zombies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "image-api": "node server/image-api.mjs",
    "build": "tsc --noEmit && vite build",
    "assets:environment": "python scripts/process_environment_assets.py",
    "assets:audio": "python scripts/process_audio_assets.py",
    "assets:weapons": "python scripts/process_weapon_assets.py",
    "assets:weapons-heavy": "python scripts/process_heavy_weapon_profiles.py",
    "assets:weapons-topdown": "python scripts/process_weapon_topdown_assets.py",
    "assets:characters": "python scripts/process_character_assets.py",
    "assets:characters-generate": "node scripts/generate_character_assets.mjs",
    "assets:characters-inspect": "python scripts/inspect_character_candidates.py",
    "assets:character-hands": "python scripts/process_character_hand_layers.py",
    "preview": "vite preview",
    "test": "vitest run",
    "test:image-api": "node --test tests/image-api.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^4.1.10"
  }
}
