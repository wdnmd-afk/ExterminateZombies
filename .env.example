# RightAPI image provider configuration (server-side only).
IMAGE_BASEURL=https://www.rightapi.ai/draw
IMAGE_APIKEY=replace-with-your-api-key
IMAGE_MODEL=gpt-image-2

# Optional: use an exact generation endpoint instead of resolving IMAGE_BASEURL.
# IMAGE_ENDPOINT=https://www.rightapi.ai/draw/v1/images/generations

# Optional local service settings.
# IMAGE_API_PORT=8787
# IMAGE_API_TIMEOUT_MS=150000
# IMAGE_API_POLL_INTERVAL_MS=1000
# IMAGE_API_MAX_CONCURRENT=2
# IMAGE_API_MAX_REQUEST_MB=16
# IMAGE_API_MAX_RESPONSE_MB=32
